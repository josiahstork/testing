  "shadow_projection": {
    "formula": "worldX + directionX*(supportY-worldY)*k; supportY + directionY*(supportY-worldY)*k + floorSlope*(worldX-supportX)",
    "floor_slope": 0.035,
    "sun_height_length_factor": ".30 / tan(sunElevation), clamped .09..1.05",
    "contact_shadows": "Soft receiver-clipped ellipses at explicit supports; independent of directional-light strength.",
    "dominant_key": "Daylight when strong enough; otherwise hearth, then chandelier.",
    "held_objects": "Contact darkening removed; tabletop shadow follows projected horizontal location, fades and softens with estimated lift.",
    "rebuild_on": [
      "object translation",
      "object visibility",
      "lighting controls",
      "preset",
      "reset"
    ],
    "limitations": "Authored 2.5D projection; no recovered depth map, normal map or 3D light transport.",
    "sun_length_coefficient": 0.3,
    "sun_length_min": 0.09,
    "sun_length_max": 1.05,
    "daylight_opacity_base": 0.16,
    "daylight_direct_opacity": 0.23
  },
  "render_pipeline": [
    "render outside with exposure and atmosphere",
    "render room and neutral static layers into interior buffer",
    "render floor contact/cast shadows above rug but below props",
    "render local receiver shadows before props and teaware",
    "render props, character, foreground furniture and effects",
    "multiply shared illumination over interior buffer",
    "restore original interior alpha to preserve outdoor openings",
    "composite interior over outside"
  ],
  "export_contract": {
    "lighting_maps": "RGB gain maps for multiply, not opaque scene overlays. Restore interior alpha after multiplying.",
    "shadow_maps": "Transparent black rasters, source-over on the indicated receiver at the indicated depth.",
    "neutral_assets": "Art assets remain unchanged; existing source highlights are not removed.",
    "snapshot_states": "Daylight, overcast, evening, night with wizard; daylight also without wizard. All snapshot maps use the default object arrangement."
  },
  "limitations": [
    "Existing painted highlights remain in the source images.",
    "Light maps estimate broad surface illumination without per-pixel normals.",
    "Night exterior is a graded version of the daylight landscape, not new night landscape art.",
    "Static grouped furniture uses authored shadow proxies rather than recovered silhouettes."
  ],
